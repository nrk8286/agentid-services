{
  "name": "agentid-services",
  "version": "1.0.0",
  "private": true,
  "description": "Production Cloudflare Worker and Google Agent Runtime for AgentID Services.",
  "homepage": "https://gptmarketplus.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrk8286/agentid-services.git"
  },
  "bugs": {
    "url": "https://github.com/nrk8286/agentid-services/issues"
  },
  "license": "UNLICENSED",
  "keywords": [
    "ai-agents",
    "cloudflare-workers",
    "google-cloud",
    "vertex-ai",
    "agentid"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/agentid-site.js && node --check src/customer-apps.js && node --check src/customer-app-ui.js",
    "test": "npm run check && npm run validate:bindings && npm run validate:links && npm run validate:google-ads && npm run validate:paypal-cpc && npm run validate:paypal-subscription-approvals",
    "validate": "npm test && npx wrangler deploy --dry-run",
    "dev": "wrangler dev --port 8787",
    "deploy": "npm run validate && npm run migrate:d1 && wrangler deploy",
    "migrate:d1": "wrangler d1 migrations apply agentid-services --remote",
    "tail": "wrangler tail",
    "validate:bindings": "node scripts/validate-cloudflare-bindings.mjs",
    "validate:google-ads": "node scripts/validate-google-ads-draft.mjs",
    "validate:paypal-cpc": "node scripts/validate-paypal-cpc.mjs",
    "validate:paypal-subscription-approvals": "node scripts/validate-paypal-subscription-approvals.mjs",
    "validate:links": "node scripts/validate-public-links.mjs",
    "validate:links:live": "node scripts/validate-public-links.mjs --live"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "workerd@1.20260811.1": true
  }
}
