# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=agentid-genai-app-2026
GOOGLE_CLOUD_LOCATION=global

# AgentID runtime
AGENTID_BASE_URL=https://gptmarketplus.com
AGENTID_SEARCH_DATA_STORE=projects/497730280367/locations/global/collections/default_collection/dataStores/agentid-public-knowledge
AGENTID_DAILY_SPEND_LIMIT_CENTS=1000
AGENTID_MONTHLY_SPEND_LIMIT_CENTS=10000
AGENTID_DRY_RUN=false

# Optional production adapters. Do not place secrets in this file.
AGENTID_ACTION_ENDPOINT=https://gptmarketplus.com/api/agents/actions
AGENTID_SPEND_LEDGER_ENDPOINT=https://gptmarketplus.com/api/agents/spend/reserve
AGENTID_GMAIL_ENABLED=false
AGENTID_SOCIAL_ENABLED=false
AGENTID_PAID_ADS_ENABLED=false

# ADK ambient trigger controls
ADK_TRIGGER_MAX_CONCURRENT=2
ADK_TRIGGER_MAX_RETRIES=3

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
