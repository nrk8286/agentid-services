{
  "displayName": "AgentID Agent Runtime - HTTP errors",
  "documentation": {
    "content": "Alerts when the deployed AgentID Agent Runtime records any non-2xx request during a five-minute window. Check Cloud Logging for the reasoning engine and verify the scheduler target.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Agent Runtime non-2xx responses",
      "conditionThreshold": {
        "filter": "resource.type=\"aiplatform.googleapis.com/ReasoningEngine\" AND metric.type=\"aiplatform.googleapis.com/reasoning_engine/request_count\" AND metric.label.\"response_code_class\"!=\"2xx\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": [
              "resource.label.\"reasoning_engine_id\""
            ]
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ]
}
